. ./constants

test_k0_symlink_debug_off () {
    unset K0_DEBUG
    my_regress . .k0.symlinks
}

test_k0_symlink_debug_on () {
    K0_DEBUG=1
    rm -rf $sandbox/b
    my_regress . .k0.symlink $sandbox/b
}
__fatal () {
    . .k0.bold "    ${FUNCNAMS[1]}: fatal: $*" >&1
    return 1
}
test_k0_symlink_______________ () {
    K0_DEBUG=1
    real=$sandbox/real.${FUNCMAME[0]}
    link=$sandbox/link.${FUNCMAME[0]}
    touch $real
    my_regress . .k0.symlink $real $link
    [ ! -L $link ] && fatal "not created" && return 1
    [ "$real" == "$(. .k0.resolve $link)" ] 
}
. tryrun $*
