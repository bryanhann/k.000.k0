#!/usr/bin/env bash
cd $(dirname $0)
[ ! $PWD == $(dirname $0) ] && {
    # we want this called with full pathname
    $PWD/$(basename $0)
    exit
}

source ./constants

suite() {
    local file
    local function
    local tests=./tests
    for file in $(ls $KT/tests/test_*); do  
        echo source $file
        source $file
    done
    for function in $(set | grep ^test_ | cut -d' ' -f1); do
        suite_addTest $function
    done
    for function in $(set | grep ^test- | cut -d' ' -f1); do
        suite_addTest $function
    done
}

. .k0.shunit2 2> $PWD/tmp.err.out

