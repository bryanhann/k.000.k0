. .k0.debug "SYMLINKING $1 $2"
. .k0.debug "    real: $1"
. .k0.debug "    link: $2"

[ ! -z $2 ] && [ -L $2 ] && {
    . .k0.debug "    removing link"
    rm $2
}

[ ! -z $2 ] && [ -e $2 ] && {
    . .k0.debug "    could not remove link"
    return 1
}

. .k0.debug "    creating link"

ln -s $1 $2
