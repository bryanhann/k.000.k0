. kt.init

test-init-nnn--dir () {
    unset name
    unset age
    . .k0.init-nnn $KT_DATA/init-nnn.d
    [ "$dummy_name" == "bozo" ]
    [ "$dummy_age" == "42" ]
}

test-init-nnn--missing () {
    unset name
    unset age
    . .k0.init-nnn $KT_DATA/init-nnn.d/foo
    [ "$dummy_name" == "bozo" ]
    [ "$dummy_age" == "42" ]
}

. kt.run $*
