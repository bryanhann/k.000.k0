#!/usr/bin/env bash
cd $(dirname $0)
fatal () {
    . .k0.bold "    ${FUNCNAMS[1]}: fatal: $*" >&1
    return 1
}

[ ! $PWD == $(dirname $0) ] && {
    # we want this called with full pathname
    $PWD/$(basename $0)
    exit
}
oneTimeSetUp() {
   sandbox=$PWD/sandbox
   mkdir -p $sandbox
   reg=$PWD/regress.output
   exp=$reg/exp
   got=$HOME/.tmp.k0test.got
   rm $got/*
   rmdir  $got
   mkdir -p $exp
   mkdir -p $got
}

oneTimeTearDown() {
   rm -rf $sandbox
}

my_regress () {
    local fun=${FUNCNAME[1]}
    local exp_stdout=$exp/out.$fun
    local exp_stderr=$exp/err.$fun
    local got_stdout=$got/out.$fun
    local got_stderr=$got/err.$fun
    $* > $got_stdout 2> $got_stderr
    err=0
    cmp $got_stdout $exp_stdout > /dev/null || err=$(( $err + 1 ))
    cmp $got_stderr $exp_stderr > /dev/null || err=$(( $err + 2 ))
    return $err
}
suite() {
    local file
    local function
    for file in $(ls test_*); do  
        source ./$file
    done
    for function in $(set | grep ^test_k0 | cut -d' ' -f1); do
        suite_addTest $function
    done
}

. .k0.shunit2 2> err.out

$PWD/regress.test
