#!/usr/bin/env bash
cd $(dirname $0)
source ./constants

fatal () {
    . .k0.bold "    ${FUNCNAMS[1]}: fatal: $*" >&1
    return 1
}

[ ! $PWD == $(dirname $0) ] && {
    # we want this called with full pathname
    $PWD/$(basename $0)
    exit
}
oneTimeSetUp() {
   mkdir -p $sandbox
   rm       $the_got_dir/*
   rmdir    $the_got_dir
   mkdir -p $the_exp_dir
   mkdir -p $the_got_dir
}

oneTimeTearDown() {
   rm -rf $sandbox
}

my_regress () {
    local fun=${FUNCNAME[1]}
    local exp_stdout=$the_exp_dir/$fun.out
    local exp_stderr=$the_exp_dir/$fun.err
    local got_stdout=$the_got_dir/$fun.out
    local got_stderr=$the_got_dir/$fun.err
    $* > $got_stdout 2> $got_stderr
    err=0
    cmp $got_stdout $exp_stdout > /dev/null || err=$(( $err + 1 ))
    cmp $got_stderr $exp_stderr > /dev/null || err=$(( $err + 2 ))
    return $err
}
suite() {
    local file
    local function
    for file in $(ls test_*); do  
        source ./$file
    done
    for function in $(set | grep ^test_k0 | cut -d' ' -f1); do
        suite_addTest $function
    done
}

. .k0.shunit2 2> err.out

#$PWD/regress.test
