. ./constants

test_k0_init_nnn_dir () {
    unset name
    unset age
    . .k0.init-nnn $PWD/test.data/init-nnn.d
    [ "$dummy_name" == "bozo" ]
    [ "$dummy_age" == "42" ]
}
test_k0_init_nnn_missing () {
    unset name
    unset age
    . .k0.init-nnn $PWD/test.data/init-nnn.d/foo
    [ "$dummy_name" == "bozo" ]
    [ "$dummy_age" == "42" ]
}

. tryrun $*
