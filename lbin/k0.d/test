unset repo_foo
unset lbin_foo

. .k0

test_repo_foo () {
    [ "$repo_foo" == "bar" ]
}

test_lbin_foo () {
    [ "$lbin_foo" == "bar" ]
}

test_calling_k0_die () {
    k0 die 7
    [ $? == 7 ]
}

test_sourcing_k0_die () {
    . k0 die 8
    [ $? == 8 ]
}

test_calling_k0_inner_die () {
    k0 inner die 6
    [ $? == 6 ]
}

test_sourcing_k0_inner_die () {
    . k0 inner die 5
    [ $? == 5 ]
}

. .k0.shunit2 2> /dev/null
