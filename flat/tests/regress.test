source ./constants

expD=$the_exp_dir #$PWD/regress.output/exp
gotD=$the_got_dir #PWD/regress.output/got

bold () {
    . .k0.bold "$@"
}

scratch=$sandbox/scratch
total=0
errors=0
width=80

bold '============regression tests=============================='
bold '============regression scripts============================'
ls $expD


for name in $(ls $expD); do
    total=$(( $total + 1 ))
    exp=$expD/$name
    got=$gotD/$name
    cmp $exp $got > $scratch 2> $scratch && continue
    line_top="======[$name]========================================================"
    line_exp="======[exp]========================================================="
    line_got="======[got]========================================================="
    line_end="====================================================================="
    bold "${line_top:0:$width}"
    cat $scratch
    bold "${line_exp:0:$width}"
    cat $exp
    bold "${line_got:0:$width}"
    cat $got
    bold "${line_end:0:$width}"
    errors=$(( $errors + 1 ))
done

bold "$total tests ran with $errors errors"

remove  $scratch
