. kt.init

test-BIN--fresh () {
    unset K0_BIN
    . .k0.BIN
    [ $K0_BIN == "~/.local/bin" ]
    [ $K0_BIN == "$HOME/.local/bin" ]
}
test-BIN--reset () {
    tmp=~/.tmp/$RANDOM
    K0_BIN=$tmp
    . .k0.BIN
    [ $K0_BIN == "$tmp" ]
    [ ${PATH:0:${#tmp}} == $tmp ]    
    [ -d $tmp ]
    rmdir $tmp
}

. kt.run $*
