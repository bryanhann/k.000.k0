bs0=${BASH_SOURCE[0]}
name=$(basename $bs0)
here=

[ ! $0 == $bs0    ] && >&2 echo "[$bs0]: must be called, not sourced"
[ ! $0 == $bs0    ] && return 1
[   $0 == ./$name ] && here=$PWD
[ ${0:0:1} == /   ] && here=$(dirname $0)
[ -z $here        ] && >&2 echo "[$0]: must be called with full pathname"
[ -z $here        ] && exit 2

bin=~/.local/bin

rm $bin/.k0* 2> /dev/null
for real in $(ls $here/flat/k0*); do
    link=$bin/.$(basename $real)
    [ ! -z $K0_DEBUG ] && echo ln -s $real $link
    ln -s $real $link
done

