k0-init4this () {
    local path
    local found=
    for path in $(k0-root-to $1); do
        [ -d $path/.git ] && found=1
        [ -z $found ] && continue
        [ -f $path/.init/init.sh ] && {
            k0-debug source $path/.init/init.sh
            source $path/.init/init.sh
        }
    done
}
